# ==============================================
# FRONTEND API CONFIGURATION
# ==============================================

# Local Development
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Production - Option 1: Với SSL (Recommended)
# VITE_API_URL=https://projecthub.io.vn/api
# VITE_WS_URL=wss://projecthub.io.vn/ws

# Production - Option 2: Chưa có SSL (HTTP only)
# VITE_API_URL=http://projecthub.io.vn/api
# VITE_WS_URL=ws://projecthub.io.vn/ws

# ==============================================
# NOTES:
# ==============================================
# 1. Copy file này thành .env: cp .env.example .env
# 2. Với local development, giữ nguyên config trên
# 3. Production với SSL: Dùng https:// và wss://
# 4. Production chưa SSL: Dùng http:// và ws://
# 5. Không commit file .env vào git
