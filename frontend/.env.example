# ==============================================
# FRONTEND API CONFIGURATION
# ==============================================

# Local Development
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Production (uncomment when deploy)
# VITE_API_URL=https://projecthub.io.vn/api
# VITE_WS_URL=wss://projecthub.io.vn/ws

# ==============================================
# NOTES:
# ==============================================
# 1. Copy file này thành .env: cp .env.example .env
# 2. Với local development, giữ nguyên config trên
# 3. Khi deploy production, uncomment phần Production và sửa domain
# 4. Không commit file .env vào git
